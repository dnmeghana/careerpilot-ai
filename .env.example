# Backend configuration
APP_NAME=CareerPilot API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://db_user:db_password@localhost:5432/careerpilot
JWT_SECRET=replace-with-a-long-random-development-secret
AI_API_KEY=replace-with-your-development-ai-key
AI_MODEL=careerpilot-local
FRONTEND_URL=http://localhost:5173

# Frontend configuration (copy to frontend/.env when running Vite)
VITE_API_URL=http://localhost:8000/api
